<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {% endif %}eight1five design</title>
  <meta name="description" content="{% if description %}{{ description }}{% else %}eight1five design studio — Software built to power business. High-performance digital products & deterministic systems.{% endif %}">
  <link rel="icon" type="image/svg+xml" href="/brand_marks/logo-dark.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --sand: #F0EAE0;
      --cream: #FDFBF7;
      --dusk: #0B0F19;
      --charcoal: #131924;
      --sienna: #0B0F19;
      --amber: #D97706;
      --amber-warm: #E8A030;
      --amber-pale: rgba(217,119,6,0.1);
      --rust: rgba(217,119,6,0.15);
      --mist: rgba(11,15,25,0.08);
      --slate: #4E5A70;
      --serif: 'Space Grotesk', sans-serif;
      --sans: 'Inter', sans-serif;
    }
    html, body { background: var(--cream); color: var(--dusk); font-family: var(--sans); line-height: 1.6; }
    body { min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; }

    /* Main Header Navigation (Responsive with Dynamic Scroll Shrink Animation) */
    .lab-strip {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      height: 4.75rem;
      background: var(--dusk);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 4vw;
      border-bottom: 1px solid rgba(253,251,247,0.08);
      backdrop-filter: blur(12px);
      transition: height 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }
    .lab-strip.scrolled {
      height: 3.1rem;
      background: rgba(11, 15, 25, 0.96);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
      border-bottom-color: rgba(253, 251, 247, 0.14);
    }
    .lab-strip__logo {
      font-family: var(--serif);
      font-size: clamp(1.05rem, 2.5vw, 1.35rem);
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--cream);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: clamp(0.5rem, 1.5vw, 0.85rem);
      text-transform: none;
      transition: font-size 0.3s ease, gap 0.3s ease;
    }
    .lab-strip.scrolled .lab-strip__logo {
      font-size: 0.95rem;
      gap: 0.5rem;
    }
    .lab-strip__logo img {
      width: clamp(2rem, 4vw, 2.5rem);
      height: clamp(2rem, 4vw, 2.5rem);
      display: block;
      flex-shrink: 0;
      transition: width 0.3s ease, height 0.3s ease;
    }
    .lab-strip.scrolled .lab-strip__logo img {
      width: 1.4rem;
      height: 1.4rem;
    }
    .lab-strip__links {
      display: flex;
      align-items: center;
      gap: clamp(0.6rem, 2vw, 1.5rem);
      font-size: clamp(0.75rem, 1.5vw, 0.9rem);
      font-family: var(--sans);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      transition: font-size 0.3s ease, gap 0.3s ease;
    }
    .lab-strip.scrolled .lab-strip__links {
      font-size: 0.76rem;
      gap: 1rem;
    }
    .lab-strip__links a { color: rgba(253,251,247,0.75); text-decoration: none; transition: color 0.2s; white-space: nowrap; }
    .lab-strip__links a:hover, .lab-strip__links a.current { color: var(--amber); }
    .lab-strip__links .sep { color: rgba(253,251,247,0.25); }

    @media (max-width: 480px) {
      .lab-strip {
        padding: 0 3vw;
      }
      .lab-strip__links {
        gap: 0.5rem;
        font-size: 0.72rem;
      }
      .lab-strip__links .sep {
        display: none;
      }
    }

    main { flex: 1; padding-top: 4.75rem; }

    /* ── Horizon: Organic Anti-Grid System ── */
    .hor-page { overflow: hidden; }

    /* Asymmetric hero: text breaks out of the grid */
    .hor-hero {
      min-height: 55vh;
      padding: 6vw 6vw 4vw;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: var(--cream);
    }
    /* Decorative diagonal sweep */
    .hor-hero::before {
      content: '';
      position: absolute;
      top: 0; right: 0;
      width: 45%;
      height: 100%;
      background: var(--sand);
      clip-path: polygon(15% 0%, 100% 0%, 100% 100%, 0% 100%);
      pointer-events: none;
    }
    /* Large watermark text */
    .hor-hero::after {
      content: 'e1F';
      position: absolute;
      bottom: -0.1em;
      right: 0.05em;
      font-family: var(--serif);
      font-size: clamp(10rem, 25vw, 22rem);
      font-weight: 700;
      font-style: italic;
      color: var(--amber);
      opacity: 0.045;
      line-height: 1;
      pointer-events: none;
      user-select: none;
    }
    .hor-hero__content { position: relative; z-index: 1; }
    .hor-eyebrow {
      font-family: var(--sans);
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--amber);
      margin-bottom: 2.5rem;
    }
    /* Title deliberately offset from center */
    .hor-hero__title {
      font-family: var(--serif);
      font-size: clamp(2.6rem, 6.5vw, 5.8rem);
      font-weight: 700;
      line-height: 1.22;
      letter-spacing: -0.03em;
      color: var(--dusk);
      max-width: 14ch;
    }
    .hor-hero__title .italic { font-style: normal; font-weight: 700; color: var(--amber); }

    /* Float: asymmetric scripture block */
    .hor-scripture {
      margin-top: 4rem;
      max-width: 36ch;
      margin-left: 12vw;
      padding: 2rem;
      background: var(--dusk);
      position: relative;
    }
    .hor-scripture::before {
      content: '';
      position: absolute;
      top: -8px;
      left: -8px;
      right: 8px;
      bottom: 8px;
      border: 1.5px solid var(--amber);
      pointer-events: none;
    }
    .hor-scripture p { font-family: var(--serif); font-size: 0.9rem; font-style: italic; color: rgba(253,251,247,0.75); line-height: 1.75; }
    .hor-scripture cite { display: block; margin-top: 0.75rem; font-family: var(--sans); font-size: 0.58rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--amber); font-style: normal; }

    /* Flowing content: large section numbers float beside text */
    .hor-section {
      padding: 6vw 6vw;
      position: relative;
    }
    .hor-section--alt { background: var(--sand); }
    .hor-section--dark { background: var(--dusk); color: var(--cream); }

    .hor-float-num {
      font-family: var(--serif);
      font-size: clamp(5rem, 12vw, 11rem);
      font-weight: 700;
      font-style: italic;
      line-height: 0.85;
      color: var(--amber);
      opacity: 0.12;
      position: absolute;
      top: 3vw;
      right: 5vw;
      user-select: none;
      pointer-events: none;
    }
    .hor-section--dark .hor-float-num { opacity: 0.07; }

    .hor-section__inner { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; }

    /* Staggered layout: not columns, shifted positions */
    .hor-stagger {
      display: grid;
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .hor-stagger__item { max-width: 70ch; }
    .hor-stagger__item:nth-child(even) { margin-left: auto; }
    .hor-stagger__item:nth-child(3n) { margin-left: 4vw; }

    /* Contact Form Layout & Components */
    .hor-contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.8fr;
      gap: 3vw;
      align-items: start;
    }
    .hor-contact-card {
      background: var(--cream);
      padding: 2.5rem;
      border-left: 3px solid var(--amber);
    }
    .hor-contact-card--alt {
      background: var(--cream);
      padding: 2.5rem;
      border-left: 3px solid var(--dusk);
    }
    .hor-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .hor-form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    .hor-form-label {
      font-size: 0.6rem;
      font-family: var(--sans);
      font-weight: 700;
      color: var(--amber);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      display: block;
      margin-bottom: 0.4rem;
    }
    .hor-form-input, .hor-form-textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid var(--mist);
      background: var(--sand);
      font-family: var(--sans);
      font-size: 0.88rem;
      color: var(--dusk);
      outline: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
      min-height: 44px;
    }
    .hor-form-textarea {
      resize: vertical;
      min-height: 120px;
    }
    .hor-form-input:focus, .hor-form-textarea:focus {
      border-color: var(--amber);
      box-shadow: 0 0 0 2px var(--amber-pale);
    }
    .hor-form-submit {
      font-family: var(--sans);
      font-size: 0.82rem;
      font-weight: 700;
      background: var(--amber);
      color: var(--dusk);
      padding: 0.85rem 1.75rem;
      border: none;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      cursor: pointer;
      align-self: flex-start;
      margin-top: 0.5rem;
      min-height: 44px;
      transition: background 0.2s ease, transform 0.15s ease;
    }
    .hor-form-submit:hover {
      background: var(--amber-warm);
    }

    @media (max-width: 868px) {
      .hor-contact-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .hor-contact-card, .hor-contact-card--alt {
        padding: 1.5rem;
      }
    }
    @media (max-width: 768px) {
      .hor-stagger__item { margin-left: 0 !important; margin-right: 0 !important; max-width: 100%; }
      .hor-scripture { margin-left: 0 !important; max-width: 100%; }
    }
    @media (max-width: 580px) {
      .hor-form-row {
        grid-template-columns: 1fr;
        gap: 1.25rem;
      }
    }

    .hor-tag {
      font-family: var(--sans);
      font-size: 0.6rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--amber);
      margin-bottom: 0.75rem;
    }
    .hor-section-title {
      font-family: var(--serif);
      font-size: clamp(1.6rem, 3.5vw, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--dusk);
      margin-bottom: 2.5rem;
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .hor-section-title::before {
      content: '';
      display: block;
      width: 2rem;
      height: 3px;
      background: var(--amber);
      flex-shrink: 0;
    }
    .hor-section--dark .hor-section-title {
      color: var(--cream);
    }
    .hor-head {
      font-family: var(--serif);
      font-size: clamp(1.5rem, 3vw, 2.2rem);
      font-weight: 700;
      line-height: 1.15;
      color: var(--dusk);
      margin-bottom: 1rem;
    }
    .hor-section--dark .hor-head { color: var(--cream); }
    .hor-text { font-size: 0.92rem; color: var(--slate); line-height: 1.8; }
    .hor-section--dark .hor-text { color: rgba(253,251,247,0.55); }

    /* Services: flowing non-grid list */
    .hor-services { display: flex; flex-direction: column; gap: 0; }
    .hor-service {
      display: grid;
      grid-template-columns: 80px 1fr auto;
      gap: 3vw;
      align-items: center;
      padding: 2.25rem 0;
      border-bottom: 1px solid rgba(253,251,247,0.08);
      transition: background 0.2s;
    }
    .hor-service:hover { background: rgba(217,119,6,0.05); }
    .hor-section--dark .hor-service { border-bottom-color: rgba(253,251,247,0.07); }
    @media (max-width: 700px) { .hor-service { grid-template-columns: 50px 1fr; } .hor-service__arrow { display: none; } }
    .hor-service__index { font-family: var(--serif); font-size: 1.5rem; font-style: italic; font-weight: 400; color: var(--amber); opacity: 0.5; line-height: 1; }
    .hor-service__info { }
    .hor-service__name { font-family: var(--serif); font-size: 1.1rem; font-weight: 700; color: var(--cream); margin-bottom: 0.4rem; }
    .hor-service__desc { font-size: 0.8rem; color: rgba(253,251,247,0.45); line-height: 1.65; max-width: 52ch; }
    .hor-service__arrow { font-size: 1.5rem; color: var(--amber); opacity: 0.3; }

    /* Pillars: organic flowing layout */
    .hor-pillars {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto;
      gap: 2px;
      background: var(--mist);
    }
    @media (max-width: 700px) { .hor-pillars { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 450px) { .hor-pillars { grid-template-columns: 1fr; } }
    .hor-pillar {
      background: var(--cream);
      padding: 2.5rem 2.25rem;
    }
    .hor-pillar:nth-child(1) { background: var(--dusk); grid-column: span 1; grid-row: span 2; }
    .hor-pillar:nth-child(1) .hor-pillar__name { color: var(--cream); }
    .hor-pillar:nth-child(1) .hor-pillar__desc { color: rgba(253,251,247,0.45); }
    .hor-pillar:nth-child(1) .hor-pillar__num { color: var(--amber); }
    .hor-pillar:nth-child(3) { background: var(--amber); }
    .hor-pillar:nth-child(3) .hor-pillar__name, .hor-pillar:nth-child(3) .hor-pillar__num { color: var(--dusk); }
    .hor-pillar:nth-child(3) .hor-pillar__desc { color: rgba(28,21,16,0.65); }
    .hor-pillar__num { font-family: var(--serif); font-size: 0.7rem; font-style: italic; color: var(--amber); margin-bottom: 1rem; }
    .hor-pillar__name { font-family: var(--sans); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--dusk); margin-bottom: 0.6rem; }
    .hor-pillar__desc { font-size: 0.8rem; color: var(--slate); line-height: 1.65; max-width: 24ch; }

    /* Footer */
    .hor-footer { background: var(--dusk); padding: 2rem 6vw; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; border-top: 1px solid rgba(253,251,247,0.1); }
    .hor-footer p, .hor-footer a { font-size: 0.85rem; color: rgba(253,251,247,0.85); font-family: var(--sans); text-decoration: none; letter-spacing: 0.04em; }
    .hor-footer a:hover { color: var(--amber); }
  </style>
</head>
<body>

  <nav class="lab-strip" aria-label="Main navigation">
    <a href="/" class="lab-strip__logo">
      <img src="/brand_marks/logo-dark.svg" alt="eight1five design logo mark">
      <span>eight1five design</span>
    </a>
    <div class="lab-strip__links">
      <a href="/" class="{% if page.url == '/' or page.url == '/index.html' or activeTab == 'home' %}current{% endif %}">Home</a>
      <span class="sep">|</span>
      <a href="/portfolio.html" class="{% if page.url == '/portfolio.html' or activeTab == 'portfolio' %}current{% endif %}">Portfolio</a>
      <span class="sep">|</span>
      <a href="/contact.html" class="{% if page.url == '/contact.html' or activeTab == 'contact' %}current{% endif %}">Contact</a>
    </div>
  </nav>

  {{ content | safe }}

  <script>
    (function() {
      const header = document.querySelector('.lab-strip');
      if (!header) return;
      function onScroll() {
        if (window.scrollY > 25) {
          header.classList.add('scrolled');
        } else {
          header.classList.remove('scrolled');
        }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>
</body>
</html>
